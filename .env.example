# Секреты и идентификаторы таблиц. Скопируйте в .env — этот файл не попадает в репозиторий.

# Токен бота от @BotFather (выглядит как 123456789:AAH...). Никому не показывайте.
BOT_TOKEN=

# Идентификатор КП: часть ссылки между /d/ и /edit
KP_SPREADSHEET_ID=

# Внутренняя таблица «Трекер» (необязательно): бот ведёт в ней копию трекера
TRACKER_SPREADSHEET_ID=

# Необязательно. Если с сервера не открывается api.telegram.org, здесь можно указать адрес
# своего прокси к Bot API (без «/bot<токен>» на конце).
# TELEGRAM_API_URL=

# Только для Railway, где нет файла настроек: текст config.yaml и номер рабочего чата.
# Подробности — docs/SETUP.md, шаг 5А.
# CONFIG_YAML=
# CONFIG_B64=
# CHAT_ID=
# THREAD_ID=
