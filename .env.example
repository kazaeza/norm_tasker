# Секреты и идентификаторы таблиц. Скопируйте в .env — этот файл не попадает в репозиторий.

# Токен бота от @BotFather (выглядит как 123456789:AAH...). Никому не показывайте.
BOT_TOKEN=

# Идентификатор КП: часть ссылки между /d/ и /edit
KP_SPREADSHEET_ID=

# Внутренняя таблица «Трекер» (необязательно): бот ведёт в ней копию трекера
TRACKER_SPREADSHEET_ID=

# Необязательно. Если с сервера не открывается api.telegram.org, здесь можно указать адрес
# своего прокси к Bot API (без «/bot<токен>» на конце).
# TELEGRAM_API_URL=

# ИИ (необязательно). Ключ Gemini: aistudio.google.com → Get API key. Без ключа бот работает без ИИ.
# GEMINI_API=
# GEMINI_MODEL=    # не задана — бот подберёт модель сам
# GEMINI_URL=      # адрес API, если ключ выдал посредник
# AI_ENABLED=1     # 0 выключает ИИ, не убирая ключ
# AI_LISTEN=1      # 0: ИИ отвечает только когда к боту обратились, общий чат не разбирает

# Мягкий старт: сколько дней после первого запуска бот только пишет утреннее саммари и не
# напоминает о сроках (по умолчанию 14). 0 включает напоминания сразу; важнее, чем soft_start_days
# в настройках.
# SOFT_START_DAYS=

# Только для облачных хостингов без файла настроек (например, Amvera): текст config.yaml и
# номер рабочего чата. Подробности — docs/SETUP.md, шаг 5А.
# CONFIG_YAML=
# CONFIG_B64=
# CHAT_ID=
# THREAD_ID=
